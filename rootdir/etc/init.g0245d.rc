on early-init
    chmod 0666 /dev/kgsl-3d0
    chown system system /dev/kgsl-3d0
    chmod 0666 /dev/ion
    chown system system /dev/ion
    chmod 0664 /dev/mdss_rotator
    chown system graphics /dev/mdss_rotator

on fs
    mount_all /vendor/etc/fstab.qcom

on post-fs
    # Do not start bootlog here. /cache is 248 MB. An unbounded logcat fills
    # it, then keeps running: one core at 100% and several hundred MB RSS.
    # The service below stays installed for a manual `start bootlog`.
    # sensors.qcom rejects /persist when realpath() differs from the path.
    # The partition is already mounted at /mnt/vendor/persist by mount_all.
    mount none /mnt/vendor/persist /persist bind

on post-fs-data
    # VoLTE: libril-qc-qmi-1's mbn_sw feature scans the hardcoded directory
    # /data/vendor/radio/modem_config/mcfg_sw, but init.qcom.sh copies the
    # firmware mcfg tree to /data/vendor/modem_config (no /radio/).  Bridge
    # the gap here, before late_start runs qcom-sh and rild starts; see
    # init.qcom.sh for the patched-mcfg installation.
    mkdir /data/vendor/radio 0770 radio radio
    symlink /data/vendor/modem_config /data/vendor/radio/modem_config
    mkdir /data/misc/camera 0770 cameraserver camera
    # A daemon killed during a previous camera session can leave cam_socket*
    # behind.  mm-qcamera-daemon then starts without binding a fresh socket
    # and CameraService enumerates 0 devices.  Clean the stale nodes before
    # class main starts the daemon.
    rm /data/misc/camera/cam_socket0
    rm /data/misc/camera/cam_socket1
    rm /data/misc/camera/cam_socket2
    rm /data/misc/camera/cam_socket3
    rm /data/misc/camera/cam_socket4
    rm /data/misc/camera/cam_socket5
    rm /data/misc/camera/cam_socket6
    rm /data/misc/camera/cam_socket7
    chmod 0775 /persist/sensors
    chmod 0664 /persist/sensors/sensors_settings
    chown system root /persist/sensors/sensors_settings
    # sns.reg is 0700 system:system from stock; the sensors daemon (uid 0,
    # then setuid to nobody with supplementary group root) cannot open it
    # and dac_override is neverallow-blocked on 18.1, so relax it instead.
    chmod 0660 /persist/sensors/sns.reg
    chown root root /persist/sensors/sns.reg
    # Same story: /dev/cpu_dma_latency is 0600 root:root and the daemon's
    # MPCTL opens it; /dev/smd8 (SLPI QMI channel, 0600 root:root) is
    # opened by sns_time. 0660 adds the group bits for supplementary
    # groups without changing ownership.
    chmod 0660 /dev/cpu_dma_latency
    chmod 0660 /dev/smd8
    chmod 0660 /persist/sensors/error_log
    chown root root /persist/sensors/error_log
    mkdir /data/misc/sensors 0775 system system
    # Start the SSC daemon here. The HAL itself is a lazy HIDL service and is
    # started by servicemanager on the framework's first request (see the
    # vendor.sensors-hal-1-0 block below).
    start sensors
    mkdir /data/vendor/display 0770 system graphics
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/audio 0770 audio audio
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    mkdir /data/misc/location 0770 gps gps
    mkdir /data/misc/location/gpsone_d 0770 gps gps
    mkdir /data/misc/location/mq 0770 gps gps
    mkdir /data/system/fingerprint 0770 system system
    mkdir /data/system/fingerprint/calibration 0770 system system
    mkdir /data/system/fingerprint/register 0770 system system
    mkdir /data/system/fingerprint/match 0770 system system
    mkdir /data/system/fingerprint/unmatch 0770 system system

on boot
    # This kernel's default governor is performance, so both clusters stay at
    # their max frequency. interactive is built in and will scale down at idle.
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor interactive
    write /sys/devices/system/cpu/cpufreq/policy2/scaling_governor interactive

    # Capacitive-key LED. The light HAL runs as system.
    chown system system /sys/class/leds/button-backlight/brightness
    chmod 0664 /sys/class/leds/button-backlight/brightness

    # Goodix GF816M. gx_fpd and the fingerprint HAL both run as system.
    chown system system /dev/goodix_fp
    chmod 0660 /dev/goodix_fp

    # Bluetooth: the HAL powers the QCA6174 through rfkill0, then libbt-vendor
    # downloads the firmware over /dev/ttyHS0.
    # The AOSP genfscon for /class/rfkill/rfkill0/state matches only the class
    # symlink path, never the real node below /sys/devices/, so the state file
    # is born generic sysfs: init could not setattr it and hal_bluetooth could
    # not write it (firmware download stuck). Relabel first (same approach as
    # qcom sepolicy-legacy), then hand it over.
    restorecon /sys/devices/vendor/vendor:bt_qca6174/rfkill/rfkill0/state
    chown bluetooth net_bt /sys/class/rfkill/rfkill0/type
    chown bluetooth net_bt /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth net_bt /sys/class/rfkill/rfkill0/device/extldo
    chmod 0660 /sys/class/rfkill/rfkill0/device/extldo
    chown bluetooth net_bt /dev/ttyHS0
    chmod 0660 /dev/ttyHS0

    # The QTI HAL keeps its random-BDADDR fallback in /data/misc/bluedroid.
    # Data carried over from earlier test ROMs can hold a stale owner there,
    # which makes the HAL fail to create btaddr_random (uid bluetooth).
    chown bluetooth bluetooth /data/misc/bluedroid
    chmod 02770 /data/misc/bluedroid

    # ADSP firmware is on the modem partition (/vendor/firmware_mnt/image).
    # The sound card registers only after the ADSP and the WCD9335 are up.
    write /sys/kernel/boot_adsp/boot 1
    chmod 0666 /dev/kgsl-3d0
    chown system system /dev/kgsl-3d0
    chmod 0666 /dev/ion
    chown system system /dev/ion
    chmod 0664 /dev/mdss_rotator
    chown system graphics /dev/mdss_rotator
    chown system graphics /sys/class/graphics/fb0/idle_time
    chown system graphics /sys/class/graphics/fb0/dynamic_fps
    chown system graphics /sys/class/graphics/fb0/dyn_pu
    chown system graphics /sys/class/graphics/fb0/modes
    chown system graphics /sys/class/graphics/fb0/mode
    chown system graphics /sys/class/graphics/fb0/msm_cmd_autorefresh_en
    chown system graphics /sys/class/graphics/fb0/lineptr_value
    chown system graphics /sys/class/graphics/fb0/msm_fb_persist_mode
    chmod 0664 /sys/class/graphics/fb0/idle_time
    chmod 0664 /sys/class/graphics/fb0/dynamic_fps
    chmod 0664 /sys/class/graphics/fb0/dyn_pu
    chmod 0664 /sys/class/graphics/fb0/modes
    chmod 0664 /sys/class/graphics/fb0/mode
    chmod 0664 /sys/class/graphics/fb0/msm_cmd_autorefresh_en
    chmod 0664 /sys/class/graphics/fb0/lineptr_value
    chmod 0664 /sys/class/graphics/fb0/msm_fb_persist_mode
    chown wifi wifi /sys/module/wlan/parameters/fwpath
    chmod 0660 /sys/module/wlan/parameters/fwpath
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    mkdir /config/usb_gadget/g1/functions/ptp.gs1
    mkdir /config/usb_gadget/g1/functions/accessory.gs2
    mkdir /config/usb_gadget/g1/functions/audio_source.gs3
    mkdir /config/usb_gadget/g1/functions/midi.gs5
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 900
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /dev/usb-ffs 0775 shell system
    mkdir /dev/usb-ffs/adb 0770 shell system
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    setprop sys.usb.controller 6a00000.dwc3
    setprop sys.usb.configfs 1
    setprop persist.sys.usb.config mtp,adb
    setprop sys.usb.config mtp,adb

# init.usb.configfs.rc links the functions. These only set the Google
# product ids, which the legacy init.usb.rc skips while configfs=1.
# Do not rewrite persist.sys.usb.config back to mtp,adb: that fights a
# mode change (ptp, midi, rndis, or charging). adb stays on via adb_enabled.
on property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7

on property:sys.usb.config=mtp && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee1

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2

on property:sys.usb.config=rndis && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee3

on property:sys.usb.config=rndis,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee4

on property:sys.usb.config=ptp && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee5

on property:sys.usb.config=ptp,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee6

on property:sys.usb.config=midi && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee8

on property:sys.usb.config=midi,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee9

on property:sys.boot_completed=1
    # Diagnostic (remove once BT works): verify the rfkill0/state label and
    # owner the on-boot restorecon/chown produced.
    # These init exec helpers use shell_exec/system_file, which init may not
    # execute_no_trans under enforcing.  The rfkill label is already verified
    # at runtime and adb_enabled defaults to 1, so both diagnostics are dropped.

# libbt-vendor sets wc_transport.start_hci once the firmware is loaded.
on property:wc_transport.start_hci=true
    start wcnss_filter

on property:wc_transport.start_hci=false
    stop wcnss_filter

service sensors /vendor/bin/sensors.qcom
    user root
    # The stock G0245D sensor daemon needs the Android 6-era QCCI transport;
    # the Android 11 gemini libqmi_cci hangs in sns_sam_init. Keep the stock
    # copy private to this service: replacing the global lib breaks cnd,
    # which needs qmi_cci_os_signal_wait from the newer library.
    setenv LD_LIBRARY_PATH /system/vendor/lib64/sensors_qcci
    # NOTE: no `socket sensor_ctl_socket` directive — stock (init.qcom.rc)
    # also has none; the daemon creates its own server socket (labeled via
    # the type_transition in sensors.te). An init-created socket just leaves
    # a second, orphaned file that clients refuse to connect to.
    # 3011 is the sensor group in /system/etc/sec_config (services 256+).
    # On this Android it is named uhid. The daemon setuid()s to nobody and
    # keeps this supplementary group; the IPC router allows the send only
    # if that group is present. adb's root shell has it, a bare init
    # service does not. 2901 (vendor_qti_diag) is /dev/diag's group and
    # 1000 (system) is /dev/sensors' group: both nodes are 0660 and the
    # daemon opens them; without the groups the opens need dac_override,
    # which is neverallow-blocked on 18.1. wakelock (3010) covers
    # /sys/power/wake_lock (0660 radio:wakelock).
    group root uhid net_raw 2901 1000 wakelock
    # The legacy daemon printf's its fatal errors to stdout; route them to
    # kmsg so they show up in logcat (kernel tag) for diagnosis.
    stdio_to_kmsg
    disabled

# Override the AOSP class-hal service. `disabled` + `interface` turns it into a
# lazy HIDL service: servicemanager starts it on the framework's first
# getService, which lands seconds after post-fs-data - by then sensors.qcom is
# already serving sns.reg and SLPI is ONLINE. Verified 2026-11-22 by booting
# with the former sensors-boot one-shot removed: 40 sensors enumerated and
# RPR0521 streaming, with sys.sensors.booted never set.
service vendor.sensors-hal-1-0 /vendor/bin/hw/android.hardware.sensors@1.0-service
    override
    interface android.hardware.sensors@1.0::ISensors default
    user system
    group system wakelock uhid context_hub
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
    disabled

service wcnss_filter /vendor/bin/wcnss_filter
    class late_start
    user bluetooth
    group bluetooth system
    disabled

service adsprpcd /vendor/bin/adsprpcd
    class main
    user media
    group media

# ADSP camera modules are loaded by the userspace daemon. The HAL connects
# to /data/misc/camera/cam_socket*. Video nodes are group camera.
# Verified 2026-11-18: sensor probe succeeds via the kernel legacy
# INIT_CFG compat path (cam4); stock blob-era daemon + LOS QCamera2 HAL.
service mm-qcamera-daemon /vendor/bin/mm-qcamera-daemon
    class main
    user cameraserver
    group camera audio input drmrpc system inet graphics
    setenv LD_PRELOAD libshim_mutex.so

# Manual only. See the note in `on post-fs`.
service bootlog /system/bin/logcat -b crash -b main -b system -f /cache/boot-logcat.txt
    user root
    group system root log
    disabled

# Stock Goodix daemon. class main starts after /data is up and before the
# late_start fingerprint HIDL service, which connects to this process.
service vendor.gx_fpd /vendor/bin/gx_fpd
    class main
    user system
    group system
